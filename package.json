{
  "name": "bm-react-native",
  "version": "0.1.0",
  "description": "React Native helpers ported from BMFlutter: device scaling, typography registry, view states, reactive persisted preferences, reusable buttons / error views and device security checks.",
  "license": "Apache-2.0",
  "author": "BakrIOS91",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "dist",
    "android",
    "ios",
    "BMReactNative.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19.0",
    "expo-blur": ">=12.0.0",
    "expo-secure-store": ">=12.0.0",
    "jail-monkey": ">=2.8.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-fs": ">=2.20.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "expo-blur": { "optional": true },
    "expo-secure-store": { "optional": true },
    "jail-monkey": { "optional": true },
    "react-native-fs": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@types/react-test-renderer": "^18.3.1",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BakrIOS91/BMReactNative.git"
  },
  "homepage": "https://github.com/BakrIOS91/BMReactNative#readme"
}
